    "seed:prod": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.1",
    "prisma": "^7.4.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  }
}