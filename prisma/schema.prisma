generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  role       Role       @default(USER)
  
  items      Item[]     @relation("UserItems")
  categories Category[] @relation("UserCategories")
  locations  Location[] @relation("UserLocations")

  @@map("users")
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String
  userId Int
  user   User   @relation("UserCategories", fields: [userId], references: [id], onDelete: Cascade)
  items  Item[] @relation("CategoryItems")

  @@map("categories")
}

model Location {
  id     Int    @id @default(autoincrement())
  name   String
  userId Int
  user   User   @relation("UserLocations", fields: [userId], references: [id], onDelete: Cascade)
  items  Item[] @relation("LocationItems")

  @@map("locations")
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  quantity    Int      @default(1)
  userId      Int
  categoryId  Int
  locationId  Int
  
  user        User     @relation("UserItems", fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation("CategoryItems", fields: [categoryId], references: [id], onDelete: Cascade)
  location    Location @relation("LocationItems", fields: [locationId], references: [id], onDelete: Cascade)

  @@map("items")
}